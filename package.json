{
  "name": "kanban-board-api",
  "version": "1.0.0",
  "description": "A Kanban board API for team management and task tracking.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate:tenants": "node scripts/migrateTenants.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "./tests/env.js"
    ],
    "setupFilesAfterEnv": [
      "./tests/setup.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^8.5.1",
    "mongodb": "^6.15.0",
    "mongoose": "^5.13.23",
    "nodemailer": "^6.10.1",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "jest": "^30.4.1",
    "mongodb-memory-server": "^11.1.0",
    "nodemon": "^2.0.22",
    "supertest": "^7.2.2"
  },
  "keywords": [
    "tasktrek",
    "api",
    "task management",
    "team management"
  ],
  "author": "Ogunseitan Gold Enoch",
  "license": "MIT"
}
