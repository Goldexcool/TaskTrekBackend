{
  "name": "kanban-board-api",
  "version": "1.0.0",
  "description": "A Kanban board API for team management and task tracking.",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "dev:watch": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "migrate:tenants": "node scripts/migrateTenants.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "tsconfig": { "strict": false, "skipLibCheck": true } }]
    },
    "setupFiles": [
      "./tests/env.js"
    ],
    "setupFilesAfterEnv": [
      "./tests/setup.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.2", 
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^8.5.1",
    "mongodb": "^6.15.0",
    "mongoose": "^5.13.23",
    "nodemailer": "^6.10.1",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^25.6.2",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.4.1",
    "mongodb-memory-server": "^11.1.0",
    "nodemon": "^2.0.22",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "tasktrek",
    "api",
    "task management",
    "team management"
  ],
  "author": "Ogunseitan Gold Enoch",
  "license": "MIT"
}
