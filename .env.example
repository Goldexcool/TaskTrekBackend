# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tasktrek

# ─── JWT / Auth ────────────────────────────────────────────────────────────────
# All three are required in production. Use long, random strings (32+ chars).
JWT_SECRET=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# ─── Email (Gmail SMTP) ────────────────────────────────────────────────────────
EMAIL_USER=
EMAIL_PASS=   # Use a Gmail App Password, not your account password

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ─── Swagger / API docs ────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:3000
